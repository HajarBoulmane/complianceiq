// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?   @map("password_hash")
  fullName     String?  @map("full_name")
  role         String   @default("user")
  createdAt    DateTime @default(now()) @map("created_at")
  googleId               String?   @unique
  isVerified             Boolean   @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?

  documents     Document[]
  conversations Conversation[]
  notifications Notification[]
  @@map("users")
}

model Document {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  filename     String?
  contractText String   @map("contract_text") @db.Text
  status       String   @default("processed") // "pending" | "processed" | "failed"
  createdAt    DateTime @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id])
  analysis     Analysis?
  obligations   Obligation[]
  notifications Notification[]
  @@map("documents")
}

model Analysis {
  id                Int      @id @default(autoincrement())
  documentId        Int      @unique @map("document_id")
  scoreGlobal       Float    @map("score_global")
  resume            String   @db.Text
  categories        Json
  clausesManquantes Json     @map("clauses_manquantes")
  typeContrat       String?  @map("type_contrat")
  typeContratLabel  String?  @map("type_contrat_label")
  analysisDegraded  Boolean  @default(false) @map("analysis_degraded")
  createdAt         DateTime @default(now()) @map("created_at")

  document          Document  @relation(fields: [documentId], references: [id])
  findings          Finding[]

  @@map("analyses")
}

model Finding {
  id                    Int      @id @default(autoincrement())
  analysisId            Int      @map("analysis_id")
  clause                String
  severite              String
  categorie             String?
  description           String   @db.Text
  referenceLegale       String?  @map("reference_legale")
  referenceHallucinated Boolean  @default(false) @map("reference_hallucinated")

  analysis        Analysis @relation(fields: [analysisId], references: [id])
  suggestedClause String? @map("suggested_clause") @db.Text
  @@map("findings")
}


model Conversation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String?  // ex: première question posée, pour identifier la conversation dans une liste
  createdAt DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  role           String   // "user" | "assistant"
  content        String   @db.Text
  sources        Json?    // [{ sourceFile, chunkIndex, distance }] — seulement pour role="assistant"
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@map("messages")
}

model Obligation {
  id          Int       @id @default(autoincrement())
  documentId  Int       @map("document_id")
  type        String    // "RENEWAL" | "PAYMENT" | "NOTICE" | "OTHER"
  description String    @db.Text
  dueDate     DateTime? @map("due_date") // nullable: le LLM n'invente jamais de date
  status      String    @default("pending") // "pending" | "done" | "dismissed"
  createdAt   DateTime  @default(now()) @map("created_at")

  document    Document  @relation(fields: [documentId], references: [id])

  @@map("obligations")
}

model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  documentId Int?      @map("document_id")
  type       String    // "RENEWAL_DUE" | "PAYMENT_DUE" | "CLAUSE_SUGGESTED"
  message    String    @db.Text
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id])
  document   Document? @relation(fields: [documentId], references: [id])

  @@map("notifications")
}